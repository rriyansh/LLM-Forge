{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [{ "expr": "sum(rate(llmforge_http_requests_total[1m])) by (path)" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "P50/P95/P99 Latency",
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(llmforge_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(llmforge_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(llmforge_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Tokens/sec",
      "targets": [{ "expr": "sum(rate(llmforge_tokens_out_total[1m]))", "legendFormat": "output tokens/s" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Cache Hit Rate",
      "targets": [{ "expr": "sum(rate(llmforge_cache_hits_total[5m])) / (sum(rate(llmforge_cache_hits_total[5m])) + sum(rate(llmforge_cache_misses_total[5m])))" }],
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Safety Blocks (5m)",
      "targets": [{ "expr": "sum(increase(llmforge_safety_blocks_total[5m]))" }],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 }
    }
  ],
  "schemaVersion": 39,
  "title": "LLM-Forge",
  "uid": "llm-forge-main",
  "version": 1
}
