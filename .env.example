# ============ CORE ============
ENV=prod
APP_VERSION=2.0.0
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ============ MODEL ============
MODEL_ID=meta-llama/Meta-Llama-3-8B
MERGED_MODEL_PATH=/models/merged
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL_WARMUP_ENABLED=true
MODEL_WARMUP_PROMPTS=2

# ============ TRAINING ============
WANDB_API_KEY=your_wandb_key
WANDB_PROJECT=llm-forge
WANDB_ENTITY=your_org

# ============ AUTH / SECURITY ============
# JWT signing key (min 64 hex chars). Generate: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_64_hex_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# Master API key for internal services (min 32 chars)
API_KEY=replace_with_32_plus_random_chars

# HMAC signing for inter-service requests
REQUEST_SIGNING_KEY=replace_with_32_plus_random_chars

# IP allowlist (comma-separated CIDR); empty = allow all
IP_ALLOWLIST=

# ============ RATE LIMITING ============
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
REDIS_URL=redis://redis:6379/0

# ============ CACHING ============
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY=0.95
CACHE_REDIS_URL=redis://redis:6379/1

# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://llmforge:password@postgres:5432/llmforge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============ vLLM ENGINE ============
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_NUM_SEQS=64

# ============ SAFETY ============
ENABLE_PII_REDACTION=true
ENABLE_TOXICITY_FILTER=true
ENABLE_PROMPT_INJECTION_FILTER=true
MAX_INPUT_TOKENS=32000
MAX_REQUEST_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=60

# ============ CORS ============
ALLOWED_ORIGINS=https://yourdomain.com

# ============ OBSERVABILITY ============
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=llm-forge
PROMETHEUS_ENABLED=true

# ============ VAULT (optional) ============
VAULT_ENABLED=false
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/llm-forge
